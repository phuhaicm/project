@model List<PoiNarration.Web.Models.DashboardTopBoothDto>

@{
    ViewData["Title"] = "Dashboard";
    // Ép kiểu an toàn để tránh lỗi NullReference
    var totalBooths = ViewBag.TotalBooths != null ? (int)ViewBag.TotalBooths : 0;
    var totalOwners = ViewBag.TotalOwners != null ? (int)ViewBag.TotalOwners : 0;
    var totalPlayback = ViewBag.TotalPlayback != null ? (int)ViewBag.TotalPlayback : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1">Dashboard</h2>
        <p class="text-muted mb-0">Thống kê tổng quan hoạt động thuyết minh gian hàng</p>
    </div>
    @* Có thể thêm nút Làm mới dữ liệu tại đây *@
    <button class="btn btn-outline-primary btn-sm" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> Làm mới
    </button>
</div>

<div class="row g-3 mb-4">
    @* Tổng số Booth *@
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow border-0 h-100 kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Tổng số booth</div>
                    <div class="fs-3 fw-bold">@totalBooths.ToString("N0")</div>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="bi bi-shop fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    @* Tổng Owner *@
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow border-0 h-100 kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Tổng chủ gian hàng</div>
                    <div class="fs-3 fw-bold">@totalOwners.ToString("N0")</div>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    @* Lượt nghe TTS *@
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow border-0 h-100 kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Lượt nghe thuyết minh</div>
                    <div class="fs-3 fw-bold">@totalPlayback.ToString("N0")</div>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="bi bi-volume-up fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    @* Trạng thái *@
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow border-0 h-100 kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">Trạng thái hệ thống</div>
                    <div class="fs-5 fw-bold text-success d-flex align-items-center">
                        <span class="p-1 bg-success rounded-circle me-2 animate-pulse"></span> Online
                    </div>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card card-shadow border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h5 class="mb-0 fw-bold">Top 10 Gian hàng hoạt động mạnh</h5>
                <small class="text-muted">Dựa trên tổng lượt phát âm thanh thuyết minh</small>
            </div>
            <i class="bi bi-trophy text-warning fs-4"></i>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-light border-dashed text-center py-5">
                <i class="bi bi-cloud-slash fs-1 text-muted d-block mb-2"></i>
                <span class="text-muted">Chưa có dữ liệu thống kê playback.</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 60px;">#</th>
                            <th>Thông tin Gian hàng</th>
                            <th class="text-end">Lượt phát thuyết minh</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rank = 1; }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    @if(rank <= 3) {
                                        <span class="badge rounded-pill bg-warning text-dark">@rank</span>
                                    } else {
                                        <span class="text-muted fw-bold">@rank</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.BoothName</div>
                                    <div class="text-muted small">ID: @item.BoothId</div>
                                </td>
                                <td class="text-end">
                                    <span class="badge bg-soft-primary border border-primary text-primary fs-6 fw-normal px-3">
                                        @item.Count.ToString("N0")
                                    </span>
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    /* CSS bổ sung để dashboard nhìn "xịn" hơn */
    .bg-soft-primary { background-color: rgba(13, 110, 253, 0.05); }
    .border-dashed { border-style: dashed !important; border-width: 2px !important; }
    
    .animate-pulse {
        width: 10px;
        height: 10px;
        display: inline-block;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(25, 135, 84, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(25, 135, 84, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(25, 135, 84, 0); }
    }
</style>