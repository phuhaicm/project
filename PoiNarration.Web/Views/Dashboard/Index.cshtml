@model PoiNarration.Web.ViewModels.DashboardIndexVm

@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="section-title"> Bảng điều khiển</h2>
        <p class="section-subtitle">Thống kê tổng quan hệ thống PoiNarration</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Tổng số booth</div>
                    <div class="fs-3 fw-bold">@Model.Summary.TotalBooths</div>
                </div>
                <div class="icon-box"><i class="bi bi-shop"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Tổng owner</div>
                    <div class="fs-3 fw-bold">@Model.Summary.TotalOwners</div>
                </div>
                <div class="icon-box"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Tổng lượt phát</div>
                    <div class="fs-3 fw-bold">@Model.Summary.TotalPlaybackLogs</div>
                </div>
                <div class="icon-box"><i class="bi bi-volume-up"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Phát hôm nay</div>
                    <div class="fs-3 fw-bold">@Model.Summary.PlaybackToday</div>
                    <div class="small text-muted">Avg: @Model.Summary.AverageDurationSeconds.ToString("0.0")s</div>
                </div>
                <div class="icon-box"><i class="bi bi-bar-chart-line"></i></div>
            </div>
        </div>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Tổng visitor</div>
                    <div class="fs-3 fw-bold">@Model.Summary.TotalVisitors</div>
                </div>
                <div class="icon-box"><i class="bi bi-person-badge"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Visitor hoạt động hôm nay</div>
                    <div class="fs-3 fw-bold">@Model.Summary.ActiveVisitorsToday</div>
                </div>
                <div class="icon-box"><i class="bi bi-person-check"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Visitor đang hoạt động</div>
                    <div class="fs-3 fw-bold">@Model.Summary.OnlineVisitors</div>
                    <div class="small text-muted">5 phút gần nhất</div>
                </div>
                <div class="icon-box"><i class="bi bi-broadcast-pin"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card card-shadow kpi-card">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted">Tổng lượt ghé booth</div>
                    <div class="fs-3 fw-bold">@Model.Summary.TotalBoothVisits</div>
                </div>
                <div class="icon-box"><i class="bi bi-geo-alt"></i></div>
            </div>
        </div>
    </div>
</div>
<div class="row g-4">
    <div class="col-12 col-lg-6">
        <div class="card card-shadow h-100">
            <div class="card-body">
                <h5 class="mb-3">Top gian hàng</h5>
                @if (!Model.TopBooths.Any())
                {
                    <div class="alert alert-info mb-0">Chưa có dữ liệu.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-hover">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Booth</th>
                                    <th>Lượt phát</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var rank = 1; }
                                @foreach (var item in Model.TopBooths)
                                {
                                    <tr>
                                        <td class="fw-bold">@rank</td>
                                        <td>
                                            <div class="fw-semibold">@item.BoothName</div>
                                            <div class="text-muted small">@item.BoothId</div>
                                        </td>
                                        <td><span class="badge bg-primary fs-6">@item.Count</span></td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card card-shadow h-100">
            <div class="card-body">
                <h5 class="mb-3">Nhật ký phát gần nhất</h5>
                @if (!Model.LatestLogs.Any())
                {
                    <div class="alert alert-info mb-0">Chưa có log nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle table-hover">
                            <thead>
                                <tr>
                                    <th>Booth</th>
                                    <th>Cách kích hoạt</th>
<th>Ngôn ngữ</th>
<th>Thời lượng</th>
<th>Thời gian</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in Model.LatestLogs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@log.BoothName</div>
                                            <div class="text-muted small">@log.BoothId</div>
                                        </td>
                                        <td>@log.TriggerType</td>
                                        <td>@log.Language</td>
                                        <td>@log.DurationSeconds s</td>
                                        <td>@log.PlayedAtUtc.ToLocalTime().ToString("dd/MM HH:mm:ss")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="row g-4 mt-1">
    <div class="col-12 col-lg-6">
        <div class="card card-shadow h-100">
            <div class="card-body">
                <h5 class="mb-3">Ngôn ngữ visitor phổ biến</h5>
                @if (!Model.TopVisitorLanguages.Any())
                {
                    <div class="alert alert-info mb-0">Chưa có dữ liệu visitor.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.TopVisitorLanguages)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.Language</span>
                                <strong>@item.Count</strong>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card card-shadow h-100">
            <div class="card-body">
                <h5 class="mb-3">Top booth được ghé</h5>
                @if (!Model.TopVisitedBooths.Any())
                {
                    <div class="alert alert-info mb-0">Chưa có dữ liệu lượt ghé.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.TopVisitedBooths)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.BoothId</span>
                                <strong>@item.Count</strong>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
<div class="card card-shadow mt-4">
    <div class="card-body">
        <h5 class="mb-3">Biểu đồ Top Booths (Trực quan)</h5>
        @if (Model.TopBooths.Any())
        {
            <canvas id="topBoothsChart" height="100"></canvas>
        }
        else
        {
            <div class="text-center py-5 text-muted">Không có dữ liệu biểu đồ</div>
        }
    </div>
</div>

<style>
    .bg-soft-primary { background-color: rgba(13, 110, 253, 0.05); }
    .card-shadow { box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); border: none; }
    .kpi-card .icon-box { font-size: 2rem; color: #0d6efd; opacity: 0.3; }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Lấy dữ liệu từ Model
        const boothLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopBooths.Select(x => x.BoothName).ToList()));
        const boothCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopBooths.Select(x => x.Count).ToList()));

        if (boothLabels.length > 0) {
            const ctx = document.getElementById('topBoothsChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: boothLabels,
                    datasets: [{
                        label: 'Lượt phát',
                        data: boothCounts,
                        backgroundColor: '#0d6efd',
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        }
    </script>
}