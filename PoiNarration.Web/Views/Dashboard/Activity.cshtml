@model List<PoiNarration.Web.Models.LatestPlaybackLogDto>

@{
    ViewData["Title"] = "Activity Logs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">Activity Logs</h3>
        <div class="text-muted">20 log phát narration gần nhất</div>
    </div>
</div>

<div class="card card-shadow">
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="alert alert-info mb-0">Chưa có log nào.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead>
                        <tr>
                            <th>Booth</th>
                            <th>Trigger</th>
                            <th>Ngôn ngữ</th>
                            <th>Duration</th>
                            <th>Thời gian</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@log.BoothName</div>
                                    <div class="text-muted small">@log.BoothId</div>
                                </td>
                                <td>@log.TriggerType</td>
                                <td>@log.Language</td>
                                <td>@log.DurationSeconds s</td>
                                <td>@log.PlayedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>