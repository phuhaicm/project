@model PoiNarration.Web.Models.UserCreateViewModel

@{
    ViewData["Title"] = "Cập nhật người dùng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card card-shadow border-0 shadow-sm mb-5">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-4 text-primary">
                        <i class="bi bi-pencil-square me-2"></i>Cập nhật người dùng
                    </h3>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Tên đăng nhập (Username)</label>
                                <input asp-for="Username" class="form-control" readonly />
                                <div class="form-text">Tên đăng nhập không thể thay đổi.</div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Họ và tên</label>
                                <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Mật khẩu mới</label>
                                <input asp-for="Password" type="password" class="form-control" placeholder="Để trống nếu không đổi..." />
                                <div class="form-text">Bỏ qua nếu giữ nguyên mật khẩu cũ.</div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Vai trò (Role)</label>
                                <select asp-for="Role" class="form-select">
                                    <option value="Admin">Quản trị viên (Admin)</option>
                                    <option value="Owner">Chủ gian hàng (Owner)</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mt-4 d-flex gap-2">
                            <button class="btn btn-primary btn-lg px-5" type="submit">
                                <i class="bi bi-save me-1"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}