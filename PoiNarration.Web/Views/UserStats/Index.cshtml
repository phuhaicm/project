@model List<PoiNarration.Web.Models.VisitorUserDto>
@{
    ViewData["Title"] = "Thống kê User";
    var stats = ViewBag.Stats as PoiNarration.Web.Models.VisitorStatsVm ?? new PoiNarration.Web.Models.VisitorStatsVm();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">@ViewData["Title"]</h3>
        <div class="text-muted small">Quản lý visitor và thống kê sử dụng app</div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Tổng Visitor</div>
                <div class="fs-3 fw-bold">@stats.TotalVisitors</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Tổng lượt ghé booth</div>
                <div class="fs-3 fw-bold">@stats.TotalVisitLogs</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="text-muted small">Tổng lượt nghe narration</div>
                <div class="fs-3 fw-bold">@stats.TotalPlaybackLogs</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold">Ngôn ngữ phổ biến</div>
            <div class="card-body">
                @if (stats.TopLanguages.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in stats.TopLanguages)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.Language</span>
                                <strong>@item.Count</strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted">Chưa có dữ liệu.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold">Top booth được ghé</div>
            <div class="card-body">
                @if (stats.TopBoothsByVisit.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in stats.TopBoothsByVisit)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.BoothId</span>
                                <strong>@item.Count</strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted">Chưa có dữ liệu.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white fw-semibold">Top booth được nghe</div>
            <div class="card-body">
                @if (stats.TopBoothsByPlayback.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var item in stats.TopBoothsByPlayback)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.BoothId</span>
                                <strong>@item.Count</strong>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted">Chưa có dữ liệu.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-semibold">Danh sách Visitor</div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>VisitorCode</th>
                        <th>DisplayName</th>
                        <th>PreferredLanguage</th>
                        <th>Platform</th>
                        <th>AppVersion</th>
                        <th>CreatedAtUtc</th>
                        <th>LastActiveAtUtc</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.VisitorCode</td>
                            <td>@item.DisplayName</td>
                            <td>@item.PreferredLanguage</td>
                            <td>@item.Platform</td>
                            <td>@item.AppVersion</td>
                            <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.LastActiveAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @{
                                    var isOnline = item.LastActiveAtUtc >= DateTime.UtcNow.AddMinutes(-5);
                                }
                                @if (isOnline)
                                {
                                    <span class="badge bg-success">Đang online</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Không online</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@{
    var activityDetails = ViewBag.ActivityDetails as List<PoiNarration.Web.Models.VisitorActivityDetailDto>
                          ?? new List<PoiNarration.Web.Models.VisitorActivityDetailDto>();
}

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-white fw-semibold">Chi tiết hoạt động theo Visitor</div>
    <div class="card-body">
        @if (activityDetails.Any())
        {
            <div class="accordion" id="visitorActivityAccordion">
                @for (int i = 0; i < activityDetails.Count; i++)
                {
                    var item = activityDetails[i];
                    var collapseId = $"collapse-{i}";
                    var headingId = $"heading-{i}";

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="false"
                                    aria-controls="@collapseId">
                                <div class="w-100 d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@item.VisitorCode</strong> - @item.DisplayName
                                        <span class="text-muted ms-2">(@item.PreferredLanguage)</span>
                                    </div>
                                    <div class="me-3">
                                        @if (item.IsOnline)
                                        {
                                            <span class="badge bg-success">Đang online</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Không online</span>
                                        }
                                    </div>
                                </div>
                            </button>
                        </h2>
                        <div id="@collapseId"
                             class="accordion-collapse collapse"
                             aria-labelledby="@headingId"
                             data-bs-parent="#visitorActivityAccordion">
                            <div class="accordion-body">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <div class="border rounded p-3">
                                            <div class="text-muted small">Tổng lượt xem booth</div>
                                            <div class="fs-5 fw-bold">@item.TotalVisitedBooths</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="border rounded p-3">
                                            <div class="text-muted small">Tổng lượt nghe booth</div>
                                            <div class="fs-5 fw-bold">@item.TotalPlayedBooths</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="border rounded p-3">
                                            <div class="text-muted small">Hoạt động gần nhất</div>
                                            <div class="fs-6 fw-bold">@item.LastActiveAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <h6 class="fw-semibold">Booth đã xem</h6>
                                        @if (item.VisitedBooths.Any())
                                        {
                                            <ul class="list-group">
                                                @foreach (var booth in item.VisitedBooths)
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <strong>@booth.BoothName</strong>
                                                            <div class="small text-muted">@booth.BoothId</div>
                                                        </div>
                                                        <div class="text-end">
                                                            <div class="fw-bold">@booth.Count lượt</div>
                                                            <div class="small text-muted">@booth.LastAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Chưa xem booth nào.</div>
                                        }
                                    </div>

                                    <div class="col-md-6">
                                        <h6 class="fw-semibold">Booth đã nghe</h6>
                                        @if (item.PlayedBooths.Any())
                                        {
                                            <ul class="list-group">
                                                @foreach (var booth in item.PlayedBooths)
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <strong>@booth.BoothName</strong>
                                                            <div class="small text-muted">@booth.BoothId</div>
                                                        </div>
                                                        <div class="text-end">
                                                            <div class="fw-bold">@booth.Count lượt</div>
                                                            <div class="small text-muted">@booth.LastAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Chưa nghe booth nào.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-muted">Chưa có dữ liệu chi tiết hoạt động.</div>
        }
    </div>
</div>
<div class="row g-4 mt-4">
    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-semibold">Biểu đồ ngôn ngữ visitor</div>
            <div class="card-body">
                <canvas id="visitorLanguagesChart" height="120"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white fw-semibold">Biểu đồ top booth được ghé</div>
            <div class="card-body">
                <canvas id="topVisitedBoothsChart" height="120"></canvas>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const langLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.TopLanguages.Select(x => x.Language).ToList()));
        const langCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.TopLanguages.Select(x => x.Count).ToList()));

        const visitBoothLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.TopBoothsByVisit.Select(x => x.BoothId).ToList()));
        const visitBoothCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(stats.TopBoothsByVisit.Select(x => x.Count).ToList()));

        if (langLabels.length > 0) {
        const ctx1 = document.getElementById('visitorLanguagesChart').getContext('2d');
        new Chart(ctx1, {
        type: 'bar',
        data: {
        labels: langLabels,
        datasets: [{
        label: 'Số visitor',
        data: langCounts,
        backgroundColor: '#198754',
        borderRadius: 6
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
        });
        }

        if (visitBoothLabels.length > 0) {
        const ctx2 = document.getElementById('topVisitedBoothsChart').getContext('2d');
        new Chart(ctx2, {
        type: 'bar',
        data: {
        labels: visitBoothLabels,
        datasets: [{
        label: 'Lượt ghé',
        data: visitBoothCounts,
        backgroundColor: '#0d6efd',
        borderRadius: 6
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
        });
        }
    </script>

}
