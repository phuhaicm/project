@model List<PoiNarration.Web.Models.BoothDto>
@{
    ViewData["Title"] = "Gian hàng của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0 fw-bold text-primary">@ViewData["Title"]</h3>
        <div class="text-muted">Chọn booth để quản lý thực đơn và món ăn</div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center">
        <i class="bi bi-info-circle-fill me-2 fs-4"></i>
        <div>Bạn chưa được gán quản lý gian hàng nào hiện tại.</div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var booth in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card card-shadow h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between mb-2">
                            <div class="fw-bold fs-5 text-dark">@booth.NameVi</div>
                            <span class="badge bg-light text-primary border">ID: @booth.Id</span>
                        </div>
                        
                        <p class="text-muted small mb-4">
                            <i class="bi bi-geo-alt me-1"></i> Quản lý danh sách món ăn cho gian hàng này.
                        </p>

                        <div class="d-flex gap-2">
                            @* Sửa lỗi <adex thành <a> chuẩn *@
                            <a class="btn btn-outline-primary btn-sm flex-fill"
                                   asp-action="Index"
                                   asp-route-boothId="@booth.Id">
                                <i class="bi bi-list-ul me-1"></i> Xem menu
                            </a>

                            @* Sửa lỗi thiếu ID ở asp-route *@
                            <a class="btn btn-primary btn-sm flex-fill"
                                   asp-action="Create"
                                   asp-route-boothId="@booth.Id">
                                <i class="bi bi-plus-lg me-1"></i> Thêm món
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}