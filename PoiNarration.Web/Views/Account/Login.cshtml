@model PoiNarration.Web.ViewModels.LoginVm
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 160px);">
    <div class="col-12 col-md-6 col-lg-4">
        <div class="glass-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="display-6 fw-bold text-primary">
                    <i class="bi bi-geo-alt-fill"></i> PoiNarration
                </div>
                <div class="text-muted small">Đăng nhập để quản trị gian hàng, tài khoản và nội dung hội chợ</div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small rounded-4">
                    <i class="bi bi-exclamation-triangle me-1"></i> @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tài khoản</label>
                    <input asp-for="Username" class="form-control form-control-lg" placeholder="vd: admin hoặc owner1" required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="vd: 123456" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-3 rounded-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                </button>

                <hr class="my-4" />

                <div class="p-3 bg-light rounded-4 border border-dashed">
                    <div class="small text-muted mb-2 fw-bold text-uppercase" style="font-size: 0.72rem;">Tài khoản dùng thử</div>
                    <div class="small text-muted d-grid gap-1">
                        <div><i class="bi bi-person-badge me-1"></i> <b>Admin:</b> admin / 123456</div>
                        <div><i class="bi bi-shop me-1"></i> <b>Owner:</b> owner1 / 123456</div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
