@model PoiNarration.Web.ViewModels.BoothCreateVm

@{
    ViewData["Title"] = "Thêm booth mới";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-shadow border-0 shadow-sm mb-5">
            <div class="card-body p-4">
                <h3 class="fw-bold mb-4 text-primary">Thêm booth mới</h3>

                @* Sửa lỗi quan trọng: Thêm enctype để upload được file ảnh *@
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        @* Thông tin cơ bản *@
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Zone (Khu vực)</label>
                            <select asp-for="ZoneId" class="form-select">
                                <option value="">-- Chọn khu vực --</option>
                                <option value="zone-a">Zone A</option>
                                <option value="zone-b">Zone B</option>
                            </select>
                            <span asp-validation-for="ZoneId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Priority (Độ ưu tiên)</label>
                            <input asp-for="Priority" class="form-control" type="number" placeholder="0" />
                        </div>

                        @* Upload Ảnh (Bổ sung để khớp với code C# của bạn) *@
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ảnh đại diện Booth</label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            <div class="form-text">Chọn ảnh chất lượng cao để hiển thị trên ứng dụng.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tên tiếng Việt</label>
                            <input asp-for="NameVi" class="form-control" />
                            <span asp-validation-for="NameVi" class="text-danger small"></span>
                        </div>


                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả tiếng Việt</label>
                            <textarea asp-for="DescVi" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Vĩ độ (Lat)</label>
                            <input asp-for="Lat" class="form-control" type="number" step="any" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Kinh độ (Lng)</label>
                            <input asp-for="Lng" class="form-control" type="number" step="any" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Bán kính (Radius)</label>
                            <input asp-for="RadiusMeters" class="form-control" type="number" />
                        </div>
                    </div>

                    @* PHẦN NỘI DUNG ĐA NGÔN NGỮ (THÊM VÀO ĐÂY) *@
                    <hr class="my-4" />
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-translate fs-4 me-2 text-info"></i>
                        <h5 class="mb-0">Dịch tự động đa ngôn ngữ</h5>
                    </div>

                    <div class="alert alert-info small">
                        Bạn chỉ cần nhập nội dung tiếng Việt. Hệ thống sẽ tự động tạo bản dịch sang các ngôn ngữ mà ứng dụng hỗ trợ.
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Kịch bản đọc tiếng Việt (TTS)</label>
                            <textarea asp-for="TtsScriptVi" class="form-control" rows="3"></textarea>
                            <div class="form-text">Nếu để trống, hệ thống có thể dùng mô tả tiếng Việt để sinh lời đọc mặc định.</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Đường dẫn file Audio tiếng Việt (URL)</label>
                            <input asp-for="AudioUrlVi" class="form-control" placeholder="https://..." />
                        </div>
                    </div>
                        


                        <div class="alert alert-warning small">Không có cấu hình ngôn ngữ bổ sung.</div>
                    

                    @* Nút bấm *@
                    <div class="mt-4 d-flex gap-2">
                        <button class="btn btn-primary btn-lg px-5" type="submit">
                            <i class="bi bi-check-circle me-1"></i> Tạo Booth
                        </button>
                        <a class="btn btn-outline-secondary btn-lg px-4" asp-action="Index">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}