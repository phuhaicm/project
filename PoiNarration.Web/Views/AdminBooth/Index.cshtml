@model List<PoiNarration.Web.Models.BoothDto>
@{
    ViewData["Title"] = "Quản lý Owner/Booth";
    var owners = ViewBag.Owners as List<PoiNarration.Web.Models.AppUserDto> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-0">@ViewData["Title"]</h3>
        <div class="text-muted small">Gán Owner và quản lý trạng thái gian hàng</div>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Thêm booth
    </a>
</div>

<div class="card card-shadow border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input id="searchBox" class="form-control border-start-0" placeholder="Tìm booth theo tên / id..." />
                </div>
            </div>
            <div class="col-12 col-md-7 text-md-end">
                <span class="badge bg-info text-dark">Tổng booth: @Model.Count</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-hover" id="boothTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;">STT</th>
                        <th>Booth</th>
                        <th>Owner hiện tại</th>
                        <th style="width: 320px;">Gán owner mới</th>
                        <th class="text-end" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                    }
                    @foreach (var booth in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">
                                @stt
                                @{
                                    stt++;
                                }
                            </td>
                                @* Biểu tượng chữ i nhỏ gọn, rê chuột vào sẽ thấy ID ẩn *@
                                <td>
                                    <div class="fw-semibold">@booth.NameVi</div>
    
                                    @* Nút Copy 1 chạm (Tự động bọc sẵn chữ booth: vào ID) *@
                                    <span class="badge bg-light text-secondary border mt-1"
                                          title="Nhấn để copy mã QR"
                                          style="cursor: pointer;"
                                          onclick="copyQrCode(this, '@booth.Id')">
                                        <i class="bi bi-clipboard"></i> Copy mã QR
                                    </span>
                                </td>
                            
                            <td>
                                @if (!string.IsNullOrWhiteSpace(booth.OwnerUserId))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">@booth.OwnerUserId</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary">Chưa gán</span>
                                }
                            </td>
                            <td>
                                <form asp-action="AssignOwner" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="boothId" value="@booth.Id" />
                                    <select class="form-select form-select-sm" name="ownerUserId">
                                        <option value="">-- Chọn owner --</option>
                                        @foreach (var owner in owners)
                                        {
                                            <option value="@owner.Id" selected="@(booth.OwnerUserId == owner.Id)">
                                                @owner.Username
                                            </option>
                                        }
                                    </select>
                                    <button class="btn btn-primary btn-sm text-nowrap" type="submit">
                                        Gán
                                    </button>
                                </form>
                            </td>
                            @* PHẦN CODE MỚI ĐÃ SỬA LỖI CÚ PHÁP *@
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    @* Nút Sửa *@
                                    <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@booth.Id" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @* Nút Ẩn/Hiện *@
                                    <form asp-action="ToggleActive" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@booth.Id" />
            
                                        @* Kiểm tra trạng thái: Nếu đang Active (Mở) thì hiện nút Đóng (Màu cam) *@
                                        @if (booth.IsActive)
                                        {
                                            <button class="btn btn-outline-warning btn-sm" type="submit"
                                                    onclick="return confirm('Bạn có chắc chắn muốn ẨN gian hàng này khỏi Ứng dụng?');"
                                                    title="Đang bật - Bấm để ẩn">
                                                <i class="bi bi-eye-slash"></i>
                                            </button>
                                        }
                                        @* Nếu đang bị Ẩn thì hiện nút Mở lại (Màu xanh) *@
                                        else
                                        {
                                            <button class="btn btn-outline-success btn-sm" type="submit"
                                                    onclick="return confirm('Bạn muốn MỞ LẠI gian hàng này trên Ứng dụng?');"
                                                    title="Đang ẩn - Bấm để mở lại">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        document.getElementById('searchBox').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            const rows = document.querySelectorAll('#boothTable tbody tr');
            rows.forEach(r => {
                const boothContent = r.querySelector('td:first-child').innerText.toLowerCase();
                r.style.display = boothContent.includes(q) ? '' : 'none';
            });
        });
        function copyQrCode(buttonElement, textToCopy) {
            // Lệnh copy text vào Clipboard của máy tính
            navigator.clipboard.writeText(textToCopy).then(function() {
                // Lưu lại nội dung cũ của nút
                const originalHtml = buttonElement.innerHTML;
                
                // Đổi nút thành màu xanh báo hiệu thành công
                buttonElement.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> Đã copy!';
                
                // Trả lại hình dáng cũ sau 2 giây
                setTimeout(() => {
                    buttonElement.innerHTML = originalHtml;
                }, 2000);
            }).catch(function(err) {
                alert('Không thể copy, lỗi: ' + err);
            });
        }
    </script>
}