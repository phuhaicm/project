<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.ZoneListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Zones">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="{DynamicResource Ui_ChooseZone}" FontSize="22"/>

        <Button Text="{DynamicResource Ui_ZoneA}" Clicked="OnZoneAClicked"/>
        <Button Text="{DynamicResource Ui_ZoneB}" Clicked="OnZoneBClicked"/>
    </VerticalStackLayout>
</ContentPage>