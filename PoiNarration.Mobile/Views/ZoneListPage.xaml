<ContentPage
    x:Class="PoiNarration.Mobile.Views.ZoneListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Zones">

    <CollectionView x:Name="ZonesView" SelectionMode="Single" SelectionChanged="OnZoneSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="12" Margin="10" CornerRadius="16">
                    <Label Text="{Binding NameVi}" FontSize="18"/>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>