<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core_model="clr-namespace:PoiNarration.Core.Models;assembly=PoiNarration.Core"
    Title="Chi tiết Trạm"
    BackgroundColor="#0B0B10"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Margin="16,16,16,8" Spacing="16">

            <Button Text="← Quay lại"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    BackgroundColor="#2A2A38"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="40"
                    Padding="16,0" />

            <Border Padding="16"
                    StrokeThickness="0"
                    BackgroundColor="#161622"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="BoothName"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label x:Name="BoothDesc"
                           FontSize="14"
                           TextColor="#B8B8C7"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Text="▶ Phát âm thanh"
                                Clicked="OnPlayClicked"
                                BackgroundColor="#6D5DF6"
                                TextColor="White"
                                CornerRadius="14" />

                        <Button Grid.Column="1"
                                Text="■ Dừng"
                                Clicked="OnStopClicked"
                                BackgroundColor="#2A2A38"
                                TextColor="White"
                                CornerRadius="14" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Menu / Sản phẩm"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        x:Name="MenuView"
                        Margin="16,0,16,16"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="core_model:BoothMenuItem">

                    <Border Margin="0,0,0,12"
                            Padding="12"
                            StrokeThickness="0"
                            BackgroundColor="#161622"
                            StrokeShape="RoundRectangle 18">

                        <Grid ColumnDefinitions="100,*" ColumnSpacing="12">

                            <Border WidthRequest="100"
                                    HeightRequest="100"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#2A2A38">
                                <Image Aspect="AspectFill">
                                    <Image.Source>
                                        <UriImageSource Uri="{Binding ImageUrl}"
                                                        CachingEnabled="True"
                                                        CacheValidity="7.00:00:00" />
                                    </Image.Source>
                                </Image>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White" />

                                <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="#B8B8C7"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <Border Padding="8,4"
                                        StrokeThickness="0"
                                        BackgroundColor="#2A2A38"
                                        StrokeShape="RoundRectangle 10"
                                        HorizontalOptions="Start"
                                        Margin="0,4,0,0">
                                    <Label Text="{Binding Price, StringFormat='{0:N0} đ'}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#4ade80" />
                                </Border>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>