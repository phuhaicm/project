<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:PoiNarration.Mobile.Views"
    Title="Chi tiết Trạm"
    BackgroundColor="#0B0B10"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header / Booth info -->
        <VerticalStackLayout Grid.Row="0" Margin="16,16,16,8" Spacing="16">

            <Button Text="← Quay lại"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    BackgroundColor="#2A2A38"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="40"
                    Padding="16,0" />

            <Border Padding="16"
                    StrokeThickness="0"
                    BackgroundColor="#161622"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="8">

                    <Image x:Name="BoothImage"
                           HeightRequest="190"
                           Aspect="AspectFill"
                           BackgroundColor="#1E1E2D"
                           Margin="0,0,0,12" />

                    <Label x:Name="BoothName"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label x:Name="BoothDesc"
                           FontSize="14"
                           TextColor="#B8B8C7"
                           LineBreakMode="WordWrap" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Text="▶ Phát âm thanh"
                                Clicked="OnPlayClicked"
                                BackgroundColor="#6D5DF6"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="46" />

                        <Button Grid.Column="1"
                                Text="■ Dừng"
                                Clicked="OnStopClicked"
                                BackgroundColor="#2A2A38"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="46" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Menu / Sản phẩm"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>

        <!-- Menu list -->
        <CollectionView Grid.Row="1"
                        x:Name="MenuView"
                        Margin="16,0,16,16"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="view:MenuItemDisplayVm">
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            StrokeThickness="0"
                            BackgroundColor="#141421"
                            StrokeShape="RoundRectangle 20">

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="12">

                            <Border Grid.Column="0"
                                    BackgroundColor="#232334"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="96"
                                       WidthRequest="96" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{Binding Name}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White" />

                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       TextColor="#B8B8C7"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />

                                <Border BackgroundColor="#1E1E2D"
                                        StrokeThickness="0"
                                        Padding="10,4"
                                        StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding PriceText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#31E981" />
                                </Border>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>