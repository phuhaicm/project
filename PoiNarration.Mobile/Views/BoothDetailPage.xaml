<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:PoiNarration.Mobile.Views"
    Title="{DynamicResource Ui_BoothDetailTitle}"
    BackgroundColor="{StaticResource PageBg}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Margin="16,16,16,8" Spacing="14">
            <Button Text="{DynamicResource Ui_Back}" 
                    Clicked="OnBackClicked" 
                    HorizontalOptions="Start" 
                    BackgroundColor="{StaticResource SurfaceSoft}" 
                    HeightRequest="40" />

            <Border Padding="16" BackgroundColor="{StaticResource SurfaceRaised}" StrokeShape="RoundRectangle 24">
                <VerticalStackLayout Spacing="10">
                    <Border BackgroundColor="{StaticResource SurfaceSoft}" StrokeShape="RoundRectangle 20">
                        <Image x:Name="BoothImage" HeightRequest="200" Aspect="AspectFill" />
                    </Border>
                    <Label x:Name="BoothName" FontSize="28" FontAttributes="Bold" />
                    <Label x:Name="BoothDesc" FontSize="14" TextColor="{StaticResource TextMuted}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                        <Button Text="{DynamicResource Ui_PlayAudio}" Clicked="OnPlayClicked" />
                        <Button Grid.Column="1" Text="■ Stop" Clicked="OnStopClicked" BackgroundColor="{StaticResource SurfaceSoft}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{DynamicResource Ui_MenuList}" FontSize="18" FontAttributes="Bold" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" x:Name="MenuView" Margin="16,0,16,16" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="view:MenuItemDisplayVm">
                    <Border Margin="0,0,0,12" Padding="12" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 22">
                        <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource SurfaceSoft}" StrokeShape="RoundRectangle 16">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="96" WidthRequest="96" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" FontSize="13" TextColor="{StaticResource TextMuted}" MaxLines="2" />
                                <Border BackgroundColor="{StaticResource SurfaceSoft}" Padding="10,4" StrokeShape="RoundRectangle 12" HorizontalOptions="Start">
                                    <Label Text="{Binding PriceText}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Accent}" />
                                </Border>
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="▶" WidthRequest="44" HeightRequest="44" CornerRadius="22" Clicked="OnPlayMenuItemClicked">
                                <Button.CommandParameter>
                                    <MultiBinding StringFormat="{}{0}. {1}">
                                        <Binding Path="Name" />
                                        <Binding Path="Description" />
                                    </MultiBinding>
                                </Button.CommandParameter>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>