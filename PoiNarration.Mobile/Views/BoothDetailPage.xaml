<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Booth Detail">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                x:Name="BoothName"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                x:Name="BoothDesc"
                FontSize="14"
                Opacity="0.8" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Play" Clicked="OnPlayClicked" />
                <Button Text="Stop" Clicked="OnStopClicked" />
            </HorizontalStackLayout>

            <Label
                Text="Menu"
                FontSize="18"
                Margin="0,12,0,0" />

            <CollectionView x:Name="MenuView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="10"
                            Margin="0,6">

                            <Grid
                                ColumnDefinitions="100,*"
                                ColumnSpacing="10">

                                <Image
                                    HeightRequest="100"
                                    WidthRequest="100"
                                    Aspect="AspectFill">
                                    <Image.Source>
                                        <UriImageSource
                                            Uri="{Binding ImageUrl}"
                                            CachingEnabled="True"
                                            CacheValidity="7.00:00:00" />
                                    </Image.Source>
                                </Image>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4">

                                    <Label
                                        Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        FontSize="16" />

                                    <Label
                                        Text="{Binding Description}"
                                        FontSize="12"
                                        Opacity="0.7" />

                                    <Label
                                        Text="{Binding Price}"
                                        FontSize="14"
                                        TextColor="DarkRed" />
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
