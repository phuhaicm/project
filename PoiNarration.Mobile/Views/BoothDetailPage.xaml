<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Booth Detail">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label x:Name="BoothName"
                   FontSize="22"
                   FontAttributes="Bold"/>

            <Label x:Name="BoothDesc"
                   FontSize="14"
                   Opacity="0.8"/>

            <Button Text="Nghe thuyết minh"
                    Clicked="OnPlayNarrationClicked"/>

            <Label Text="Menu"
                   FontSize="18"
                   Margin="0,10,0,0"/>

            <CollectionView x:Name="MenuView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="0,6" CornerRadius="14">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                <Label Text="{Binding Description}" FontSize="12" Opacity="0.7"/>
                                <Label Text="{Binding Price}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>