<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoiNarration.Mobile.Views.BoothDetailPage"
             Title="Thực đơn gian hàng"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, Auto, *">

        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="20,15,20,10">
            <Label x:Name="BoothName" 
                   Text="Đang tải tên..." 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="#333333"
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"/>

            <Label x:Name="BoothDesc" 
                   Text="" 
                   FontSize="15" 
                   TextColor="#666666"
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>
        </VerticalStackLayout>

        <VerticalStackLayout x:Name="LoadingArea" 
                             Grid.Row="1" 
                             Spacing="10" 
                             Margin="0,10"
                             IsVisible="True">
            <ActivityIndicator IsRunning="True" 
                               Color="OrangeRed" 
                               WidthRequest="40" 
                               HeightRequest="40" 
                               HorizontalOptions="Center"/>
            <Label Text="Đang cập nhật thực đơn mới nhất..." 
                   FontSize="13" 
                   TextColor="Gray" 
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <CollectionView x:Name="MenuView" 
                        Grid.Row="2" 
                        Margin="10,0"
                        SelectionMode="None">
            <CollectionView.Header>
                <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,0,0,10"/>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" 
                           Padding="10" 
                           CornerRadius="12" 
                           HasShadow="False"
                           BorderColor="#F0F0F0"
                           BackgroundColor="#FAFAFA">
                        <Grid ColumnDefinitions="100, *" ColumnSpacing="15">

                            <Image Grid.Column="0"
                                   Source="{Binding ImageUrl}" 
                                   WidthRequest="100" 
                                   HeightRequest="100" 
                                   Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="8"/>
                                </Image.Clip>
                            </Image>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Name}" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       TextColor="#222222"/>

                                <Label Text="{Binding Description}" 
                                       FontSize="13" 
                                       TextColor="#777777" 
                                       MaxLines="2" 
                                       LineBreakMode="TailTruncation"/>

                                <Label Text="{Binding Price, StringFormat='{0:N0} VNĐ'}" 
                                       FontSize="16"
                                       TextColor="OrangeRed" 
                                       FontAttributes="Bold" 
                                       Margin="0,5,0,0"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent"/>
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>