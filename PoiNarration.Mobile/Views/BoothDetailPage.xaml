<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoiNarration.Mobile.Views.BoothDetailPage"
             Title="Chi tiết gian hàng"
             BackgroundColor="#F5F5F5">

    <CollectionView x:Name="MenuView" 
                    SelectionMode="Single"
                    SelectionChanged="OnMenuItemSelected">

        <CollectionView.Header>
            <VerticalStackLayout Padding="20" Spacing="15" BackgroundColor="White">
                <Label x:Name="BoothNameLabel"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#333"
                       Text="Tên gian hàng"/>

                <Label x:Name="BoothDescLabel"
                       FontSize="15"
                       TextColor="#666"
                       LineHeight="1.2"
                       Text="Đang tải mô tả..."/>

                <Button Text="🔊 Nghe thuyết minh gian hàng"
                        Clicked="OnPlayNarrationClicked"
                        BackgroundColor="#6200ee"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontAttributes="Bold" />

                <BoxView HeightRequest="1" Color="#EEE" Margin="0,10" />

                <Label Text="Thực đơn hôm nay"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#333" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Padding="0" 
                        Margin="15,8" 
                        StrokeShape="RoundRectangle 15" 
                        StrokeThickness="0" 
                        BackgroundColor="White">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="2,4" Radius="8" Opacity="0.1" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="120, *" HeightRequest="120">
                        <Image Grid.Column="0"
                               Source="{Binding ImageUrl}" 
                               Aspect="AspectFill"
                               WidthRequest="120"
                               HeightRequest="120" />

                        <VerticalStackLayout Grid.Column="1" 
                                             Padding="12" 
                                             Spacing="4" 
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}" 
                                   FontAttributes="Bold" 
                                   FontSize="17" 
                                   TextColor="#222"/>

                            <Label Text="{Binding Description}" 
                                   FontSize="13" 
                                   TextColor="#888" 
                                   MaxLines="2" 
                                   LineBreakMode="TailTruncation"/>

                            <Label Text="{Binding Price, StringFormat='{0:N0} VNĐ'}" 
                                   TextColor="#FF8C00" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="20" Color="Transparent" />
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>