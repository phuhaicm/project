<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:PoiNarration.Mobile.Models"
    Title="{DynamicResource Ui_Page_Booths}"
    BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
        <Border Grid.Row="0" Margin="16,16,16,8" Padding="18" BackgroundColor="{StaticResource SurfaceRaised}" StrokeShape="RoundRectangle 24">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4">
                    <Label Text="PoiNarration" FontSize="26" FontAttributes="Bold" />
                    <Label x:Name="SyncStatusLabel" Text="{DynamicResource Ui_SyncReady}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{DynamicResource Ui_Sync}" Clicked="OnSyncClicked" WidthRequest="110" BackgroundColor="{StaticResource Primary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16,0,16,8" ColumnDefinitions="*,120" ColumnSpacing="10">
            <SearchBar x:Name="BoothSearchBar" Placeholder="{DynamicResource Ui_SearchPlaceholder}" TextChanged="OnSearchTextChanged" />
            <Picker x:Name="LanguagePicker" Grid.Column="1" SelectedIndexChanged="OnLanguageChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>vi</x:String>
                        <x:String>en</x:String>
                        <x:String>zh</x:String>
                        <x:String>ja</x:String>
                        <x:String>ko</x:String>
                        <x:String>fr</x:String>
                        <x:String>es</x:String>
                        <x:String>it</x:String>
                        <x:String>ru</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <Grid Grid.Row="2" Margin="16,0,16,8" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Text="{DynamicResource Ui_ScanQR}" Clicked="OnScanQrClicked" />
            <Button Grid.Column="1" Text="{DynamicResource Ui_GpsMode}" Clicked="OnGpsModeClicked" BackgroundColor="{StaticResource SurfaceSoft}" />
            <Button Grid.Column="2" Text="{DynamicResource Ui_Map}" Clicked="OnMapClicked" BackgroundColor="{StaticResource SurfaceSoft}" />
        </Grid>

        <Grid Grid.Row="3" Margin="16,0,16,8" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Padding="14" BackgroundColor="{StaticResource SurfaceRaised}" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout>
                    <Label Text="{DynamicResource Ui_TotalBooth}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    <Label x:Name="TotalBoothsLabel" Text="0" FontSize="26" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" Padding="14" BackgroundColor="{StaticResource SurfaceRaised}" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout>
                    <Label Text="{DynamicResource Ui_CurrentLang}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    <Label x:Name="CurrentLanguageLabel" Text="vi" FontSize="26" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Margin="16,0,16,8"
                Padding="14"
                BackgroundColor="{StaticResource SurfaceRaised}"
                StrokeShape="RoundRectangle 20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{DynamicResource Ui_VisitorHeader}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    <Label x:Name="VisitorCodeLabel" Text="VIS-LOCAL" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="VisitorSyncStatusLabel" Text="{DynamicResource Ui_VisitorSyncPending}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>

                <Border Grid.Column="1"
                        Padding="10,6"
                        BackgroundColor="{StaticResource SurfaceSoft}"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Center">
                    <Label x:Name="VisitorLangLabel" Text="vi" FontSize="12" TextColor="{StaticResource TextMuted}" />
                </Border>
            </Grid>
        </Border>

        <CollectionView Grid.Row="5" x:Name="BoothsCollectionView" Margin="16,0,16,16" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:BoothCardVm">
                    <Border Margin="0,0,0,12" Padding="14" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 24">
                        <Grid ColumnDefinitions="100,*" ColumnSpacing="14">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource SurfaceSoft}" StrokeShape="RoundRectangle 18">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="100" WidthRequest="100" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" />
                                <Label Text="{Binding Subtitle}" FontSize="14" TextColor="{StaticResource TextMuted}" MaxLines="2" />
                                <HorizontalStackLayout Spacing="8">
                                    <Border BackgroundColor="{StaticResource SurfaceSoft}" Padding="10,5" StrokeShape="RoundRectangle 12">
                                        <Label Text="{Binding RadiusText}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource SurfaceSoft}" Padding="10,5" StrokeShape="RoundRectangle 12">
                                        <Label Text="{Binding PriorityText}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Text="{Binding DetailText}" Clicked="OnOpenBoothClicked" CommandParameter="{Binding Id}" />
                                    <Button Grid.Column="1" Text="{Binding PreviewText}" Clicked="OnPreviewBoothClicked" CommandParameter="{Binding Id}" BackgroundColor="{StaticResource SurfaceSoft}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>