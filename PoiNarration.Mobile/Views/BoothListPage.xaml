<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:PoiNarration.Mobile.Models"
    x:Name="ThisPage"
    Title="Booths"
    BackgroundColor="#0B0B10">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <Border Grid.Row="0"
                Margin="16,16,16,8"
                Padding="16"
                StrokeThickness="0"
                BackgroundColor="#161622"
                StrokeShape="RoundRectangle 20">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="4">
                    <Label Text="PoiNarration"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />

                    <Label x:Name="SyncStatusLabel"
                           Text="Sẵn sàng đồng bộ dữ liệu"
                           FontSize="12"
                           TextColor="#B8B8C7" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Đồng bộ"
                        Clicked="OnSyncClicked"
                        BackgroundColor="#6D5DF6"
                        TextColor="White"
                        CornerRadius="14"
                        Padding="16,10"
                        HeightRequest="44" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="16,0,16,8"
              ColumnDefinitions="*,140"
              ColumnSpacing="8">
            <SearchBar x:Name="BoothSearchBar"
                       Placeholder="Tìm booth..."
                       SearchCommand="{x:Null}"
                       TextChanged="OnSearchTextChanged"
                       BackgroundColor="#161622"
                       TextColor="White"
                       PlaceholderColor="#B8B8C7" />

            <Picker x:Name="LanguagePicker"
                    Grid.Column="1"
                    Title="Ngôn ngữ"
                    SelectedIndexChanged="OnLanguageChanged"
                    BackgroundColor="#161622"
                    TextColor="White">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>vi</x:String>
                        <x:String>en</x:String>
                        <x:String>zh</x:String>
                        <x:String>ja</x:String>
                        <x:String>ko</x:String>
                        <x:String>fr</x:String>
                        <x:String>es</x:String>
                        <x:String>it</x:String>
                        <x:String>ru</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <Grid Grid.Row="2"
              Margin="16,0,16,8"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8">
            <Button Text="Quét QR"
                    Clicked="OnScanQrClicked"
                    BackgroundColor="#6D5DF6"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="46" />

            <Button Grid.Column="1"
                    Text="GPS Mode"
                    Clicked="OnGpsModeClicked"
                    BackgroundColor="#2A2A38"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="46" />

            <Button Grid.Column="2"
                    Text="Bản đồ"
                    Clicked="OnMapClicked"
                    BackgroundColor="#2A2A38"
                    TextColor="White"
                    CornerRadius="16"
                    HeightRequest="46" />
        </Grid>

        <Grid Grid.Row="3"
              Margin="16,0,16,8"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">
            <Border Padding="12"
                    StrokeThickness="0"
                    BackgroundColor="#161622"
                    StrokeShape="RoundRectangle 18">
                <VerticalStackLayout>
                    <Label Text="Tổng Booth"
                           FontSize="12"
                           TextColor="#B8B8C7" />
                    <Label x:Name="TotalBoothsLabel"
                           Text="0"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    Padding="12"
                    StrokeThickness="0"
                    BackgroundColor="#161622"
                    StrokeShape="RoundRectangle 18">
                <VerticalStackLayout>
                    <Label Text="Ngôn ngữ hiện tại"
                           FontSize="12"
                           TextColor="#B8B8C7" />
                    <Label x:Name="CurrentLanguageLabel"
                           Text="vi"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <CollectionView Grid.Row="4"
                        x:Name="BoothsCollectionView"
                        Margin="16,0,16,16"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:BoothCardVm">
                    <Border Margin="0,8,0,0"
                            Padding="12"
                            StrokeThickness="0"
                            BackgroundColor="#141421"
                            StrokeShape="RoundRectangle 20">
                        <Grid ColumnDefinitions="96,*" ColumnSpacing="12">

                            <Border Grid.Column="0"
                                    BackgroundColor="#232334"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="96"
                                       WidthRequest="96" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="{Binding Title}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation" />

                                <Label Text="{Binding Subtitle}"
                                       FontSize="14"
                                       TextColor="#B8B8C7"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <HorizontalStackLayout Spacing="8">
                                    <Border BackgroundColor="#1E1E2D"
                                            StrokeThickness="0"
                                            Padding="10,4"
                                            StrokeShape="RoundRectangle 10">
                                        <Label Text="{Binding RadiusText}"
                                               FontSize="12"
                                               TextColor="#B8B8C7" />
                                    </Border>

                                    <Border BackgroundColor="#1E1E2D"
                                            StrokeThickness="0"
                                            Padding="10,4"
                                            StrokeShape="RoundRectangle 10">
                                        <Label Text="{Binding PriorityText}"
                                               FontSize="12"
                                               TextColor="#B8B8C7" />
                                    </Border>
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                                    <Button Text="{Binding DetailText}"
                                            Clicked="OnOpenBoothClicked"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#6D5DF6"
                                            TextColor="White"
                                            CornerRadius="16"
                                            HeightRequest="44" />

                                    <Button Grid.Column="1"
                                            Text="{Binding PreviewText}"
                                            Clicked="OnPreviewBoothClicked"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#232334"
                                            TextColor="White"
                                            CornerRadius="16"
                                            HeightRequest="44" />
                                </Grid>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>