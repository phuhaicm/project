<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Booths">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Booth List (Week 1 Skeleton)" FontSize="22" />

        <Button Text="Scan Gate QR (Demo)"
                Clicked="OnScanGateClicked"/>

        <Button Text="Manual Mode (Go to Zones)"
                Clicked="OnManualClicked"/>

        <Button Text="Open Booth Detail (Demo)"
                Clicked="OnOpenDetailClicked"/>
    </VerticalStackLayout>
</ContentPage>