<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.MapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
    Title="{DynamicResource Ui_Page_Map}"
    BackgroundColor="{StaticResource PageBg}">

    <Grid RowDefinitions="*,Auto">
        <maps:Map x:Name="FoodMap" Grid.Row="0" IsShowingUser="True" />

        <Border Grid.Row="1"
                Margin="12"
                Padding="16"
                BackgroundColor="{StaticResource SurfaceRaised}"
                Stroke="{StaticResource StrokeSoft}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="10">
                    <Label x:Name="GpsStatusLabel"
                           Text="{DynamicResource Ui_GpsChecking}"
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}" />
                    <Label x:Name="BoothCountLabel"
                           Text="{DynamicResource Ui_BoothCount_Zero}"
                           FontSize="12"
                           TextColor="{StaticResource TextMuted}" />
                </HorizontalStackLayout>

                <Label x:Name="LocationLabel"
                       Text="{DynamicResource Ui_LocationChecking}"
                       FontSize="11"
                       TextColor="{StaticResource TextSubtle}" />

                <BoxView HeightRequest="1"
                         Color="{StaticResource StrokeSoft}"
                         Margin="0,4" />

                <Label Text="{DynamicResource Ui_NearestBoothHeader}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       CharacterSpacing="1.2" />

                <Label x:Name="NearestBoothName"
                       Text="{DynamicResource Ui_NearestUnknown}"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Label x:Name="NearestBoothLabel"
                       Text="{DynamicResource Ui_Empty}"
                       FontSize="13"
                       TextColor="{StaticResource TextMuted}" />

                <Label x:Name="NearestBoothDistance"
                       Text="{DynamicResource Ui_Empty}"
                       FontSize="13"
                       TextColor="{StaticResource TextMuted}" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,8,0,0">
                    <Button x:Name="OpenNearestButton"
                            Text="{DynamicResource Ui_OpenDetail}"
                            Clicked="OnOpenNearestClicked"
                            IsEnabled="False" />
                    <Button Grid.Column="1"
                            Text="{DynamicResource Ui_Refresh}"
                            Clicked="OnRefreshLocationClicked"
                            BackgroundColor="{StaticResource SurfaceSoft}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>