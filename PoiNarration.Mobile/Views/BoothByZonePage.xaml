<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothByZonePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PoiNarration.Core.Models;assembly=PoiNarration.Core"
    Title="Booths by Zone">


    <CollectionView x:Name="BoothsView"
                    SelectionMode="Single"
                    SelectionChanged="OnBoothSelected">

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Booth">
                <Frame Padding="12" Margin="10" CornerRadius="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NameVi}" FontSize="18"/>
                        <Label Text="{Binding DescVi}"
                               FontSize="12"
                               Opacity="0.7"
                               LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>