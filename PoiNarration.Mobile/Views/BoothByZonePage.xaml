<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothByZonePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Booths by Zone">

    <CollectionView x:Name="BoothsView"
                    SelectionMode="Single"
                    SelectionChanged="OnBoothSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Padding="12" Margin="10" CornerRadius="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding NameVi}" FontSize="18"/>
                        <Label Text="{Binding DescVi}" FontSize="12" Opacity="0.7"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>