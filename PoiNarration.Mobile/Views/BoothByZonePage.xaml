<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PoiNarration.Mobile.Views.BoothByZonePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PoiNarration.Core.Models;assembly=PoiNarration.Core"
    Title="{DynamicResource Ui_Page_BoothByZone}"
    BackgroundColor="{StaticResource PageBg}">

    <CollectionView x:Name="BoothsView"
                    SelectionMode="Single"
                    SelectionChanged="OnBoothSelected"
                    Margin="10">

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Booth">
                <Border Margin="0,0,0,12" 
                        Padding="14" 
                        BackgroundColor="{StaticResource Surface}" 
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding NameVi}" 
                               FontSize="18" 
                               FontAttributes="Bold" />

                        <Label Text="{Binding DescVi}"
                               FontSize="13"
                               TextColor="{StaticResource TextMuted}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>