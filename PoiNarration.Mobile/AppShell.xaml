<?xml version="1.0" encoding="utf-8" ?>
<Shell
    x:Class="PoiNarration.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PoiNarration.Mobile.Views">

    <TabBar>
        <!-- Tab Booths -->
        <ShellContent
        Route="booths"
        Title="Booths"
        ContentTemplate="{DataTemplate views:BoothListPage}" />

        <!-- Tab Map -->
        <ShellContent
        Route="map"
        Title="Map"
        ContentTemplate="{DataTemplate views:MapPage}" />
    </TabBar>

</Shell>