<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PoiNarration.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PoiNarration.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="{DynamicResource Ui_AppTitle}">

    <TabBar>
        <ShellContent
            x:Name="BoothsTab"
            Title="{DynamicResource Ui_Tab_Booths}"
            Route="BoothListPage"
            ContentTemplate="{DataTemplate views:BoothListPage}" />

        <ShellContent
            x:Name="MapTab"
            Title="{DynamicResource Ui_Tab_Map}"
            Route="MapPage"
            ContentTemplate="{DataTemplate views:MapPage}" />

        <ShellContent
            x:Name="QrTab"
            Title="{DynamicResource Ui_Tab_Qr}"
            Route="QrScanPage"
            ContentTemplate="{DataTemplate views:QrScanPage}" />
    </TabBar>
</Shell>