<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PoiNarration.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PoiNarration.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="PoiNarration">

    <TabBar>
        <ShellContent
            Title="Booths"
            Route="BoothListPage"
            ContentTemplate="{DataTemplate views:BoothListPage}" />

        <ShellContent
            Title="Map"
            Route="MapPage"
            ContentTemplate="{DataTemplate views:MapPage}" />

        <ShellContent
            Title="QR"
            Route="QrScanPage"
            ContentTemplate="{DataTemplate views:QrScanPage}" />
    </TabBar>
</Shell>